# Copy to .env.local and fill in. Never commit the filled version.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Invite code gating signups
INVITE_CODE=

# Not needed until Milestone 4. Server-side only.
# Set a hard monthly spend limit in the Anthropic Console when you create this key.
ANTHROPIC_API_KEY=

# Not needed until Milestone 4.
RESEND_API_KEY=
