# Copy to .env.local and fill in. Never commit the filled version.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Invite code gating signups. Only ever used server-side: /api/signup hashes
# and compares against app_settings.invite_code_hash (written by `npm run
# seed`, from this same value) — the plaintext code itself is never stored
# in the database.
INVITE_CODE=

# Only read by `npm run seed`, not at app runtime. The email to flag as the
# founding curator (status='approved', is_curator=true, visibility=
# 'all_members') and to seed the founding member's attendance onto.
CURATOR_EMAIL=

# Only read by `npm run seed`. Defaults to 16 (CLAUDE.md §1) if unset.
USER_CAP=16

# Not needed until Milestone 4. Server-side only.
# Set a hard monthly spend limit in the Anthropic Console when you create this key.
ANTHROPIC_API_KEY=

# Not needed until Milestone 4.
RESEND_API_KEY=
