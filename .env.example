# Copy to .env.local and fill in. Never commit the filled version.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The one gate (CLAUDE.md §6) — no accounts, no email. Only ever used
# server-side: /api/enter hashes and compares against
# app_settings.invite_code_hash (written by `npm run seed`, from this same
# value) — the plaintext code itself is never stored in the database.
INVITE_CODE=

# Only read by `npm run seed`, not at app runtime. The name to seed as the
# founding member (is_curator=true, pre-populated attendance) — no email,
# since there's no email column anymore. They link this row to their own
# session the first time they open the app, via /enter's "I've been here
# before" picker.
FOUNDING_MEMBER_NAME=

# Only read by `npm run seed`. Defaults to 16 (CLAUDE.md §1) if unset.
MEMBER_CAP=16

# Not needed until the AI conference lookup is built (deferred, not this
# milestone). Server-side only.
# Set a hard monthly spend limit in the Anthropic Console when you create this key.
ANTHROPIC_API_KEY=
